<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/character"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.48"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#520B1621"
        android:orientation="vertical"
        android:padding="14dp">
        <TextView android:id="@+id/city" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Берлин" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/temperature" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—°" android:textColor="#FFFFFF" android:textSize="36sp" android:textStyle="bold" />
        <TextView android:id="@+id/condition" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:text="Обновляем прогноз…" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxLines="2" android:text="Одевайся по погоде"
            android:textColor="#FFD8E3" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:maxLines="1" android:text=""
            android:textColor="#E3EDF4" android:textSize="11sp" />
        <TextView android:id="@+id/hourly" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxLines="2" android:text=""
            android:textColor="#FFFFFF" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
